# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=

# Google AdSense (Optional)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=
# Per-page ad unit ids (numeric). HOME_* fall back to the current units; AI_ASSISTANTS has
# no fallback, so /ai-assistants shows no ad until a real unit id is set.
VITE_ADSENSE_SLOT_AI_ASSISTANTS=
VITE_ADSENSE_SLOT_HOME_MID=
VITE_ADSENSE_SLOT_HOME_LOWER=
VITE_ENABLE_ADSENSE=false

# Stripe Payments (Optional)
VITE_ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Ads conversion tracking (Optional; inert when unset)
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_SIGNUP_LABEL=
VITE_GOOGLE_ADS_PURCHASE_LABEL=

# AI & APIs
GEMINI_API_KEY=
# Optional PAID fallback (xAI Grok, billed per token). Only used after free providers; leave unset to stay at $0.
XAI_API_KEY=
GROK_API_KEY=
