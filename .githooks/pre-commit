#!/bin/sh
set -eu

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^.githooks/pre-commit$' || true)
[ -z "$staged_files" ] && exit 0

pattern='(sk_(test|live)_[A-Za-z0-9]+|rk_(test|live)_[A-Za-z0-9]+|whsec_[A-Za-z0-9]+|sb_secret_[A-Za-z0-9]+|service_role[A-Za-z0-9_-]+)'

for file in $staged_files; do
  if git show ":$file" | grep -E "$pattern" >/dev/null 2>&1; then
    echo "Potential secret detected in staged file: $file" >&2
    exit 1
  fi
done
